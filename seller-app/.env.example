# Base de datos (Neon)
DATABASE_URL="postgresql://user:password@host/db"
DIRECT_URL="postgresql://user:password@host/db"

# Clerk — autenticación
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx

# Token interno para comunicación entre servicios
SERVICE_TOKEN=your-service-token

# API keys para autenticar requests entrantes de otras apps
BUYER_API_KEY=your-buyer-api-key
VENDOR_API_KEY=your-vendor-api-key
PAYMENTS_API_KEY=your-payments-api-key

# URLs de servicios externos para notificaciones
DELIVERY_APP_URL=https://delivery-app.vercel.app
BUYER_APP_URL=https://buyer-app.vercel.app

# API keys para autenticación saliente contra otros servicios
DELIVERY_API_KEY=your-delivery-api-key
BUYER_SERVICE_KEY=your-buyer-service-key

# FeedbackApp — reseñas
FEEDBACK_APP_URL=http://localhost:3001
FEEDBACK_API_KEY=your-feedback-api-key

# Clerk webhook secret (solo si usás webhooks)
CLERK_WEBHOOK_SECRET=whsec_xxxxx

# Cloudinary — storage de imágenes
STORAGE_PROVIDER=cloudinary
NEXT_PUBLIC_STORAGE_PROVIDER=cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-preset
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
